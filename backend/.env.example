# ── LLM API 配置 ──────────────────────────────────
# DeepSeek: https://platform.deepseek.com/
# OpenAI:   https://platform.openai.com/
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# demo 是明确标注的规则演示；llm 才调用模型 API
AI_MODE=demo
# MySQL 8.0+ / InnoDB / utf8mb4；密码含特殊字符时须 URL 编码
DATABASE_URL=mysql+pymysql://shiwu:shiwu_local@127.0.0.1:3306/shiwu?charset=utf8mb4
# 仅用于旧 SQLite 数据迁移，不作为应用数据库
DATABASE_PATH=./data/shop.db
# 本地演示账户；外部部署应关闭并自行初始化账户与商品
SEED_DEMO=true
SESSION_HOURS=24
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── 服务配置 ──────────────────────────────────────
HOST=0.0.0.0
PORT=8000
